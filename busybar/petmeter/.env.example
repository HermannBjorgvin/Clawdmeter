# BUSY Bar address. Copy this file to .env and set your device's address.
VITE_BUSY_ADDR=localhost

# Where the Petmeter daemon serves /usage.json. The default is this host on
# the bar's USB network, so nothing here is hosted anywhere -- the daemon runs
# on your machine and the bar reaches it over the USB link.
VITE_PETMETER_HOST=http://10.0.4.21:8724
